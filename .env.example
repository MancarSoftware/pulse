DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"
# Optional integrations. Keep empty when not configured.
SENTRY_DSN=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Seed only: explicitly enable demo data, never in production.
ALLOW_DEMO_SEED="false"
DEMO_PASSWORD=""
# Legacy manual sender, explicitly scoped to one organization. Embedded Signup below supports multiple gyms.
WHATSAPP_ORGANIZATION_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_WELCOME_TEMPLATE=""
WHATSAPP_RENEWAL_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es"
# Embedded Signup: configured once by the SaaS administrator, not each gym owner.
WHATSAPP_META_APP_ID=""
WHATSAPP_META_APP_SECRET=""
WHATSAPP_META_CONFIG_ID=""
# 32 random bytes encoded as 64 hex characters; store separately from DB backups.
WHATSAPP_ENCRYPTION_KEY=""
